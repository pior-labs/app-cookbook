# Application identity
APP_SLUG=cookbook
COMPOSE_PROJECT_NAME=cookbook

# Local development
API_PORT=3002
WEB_PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cookbook_dev
# Optional when the API itself runs in Docker during local development.
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/cookbook_dev

# Central Pior Labs authentication.
# Follow service-auth documentation for the current issuer and callback contract.
CENTRAL_AUTH_ISSUER=http://localhost:5173/api/auth
CENTRAL_AUTH_CLIENT_ID=cookbook
# Set only in a local .env or the production secret store. Never expose through VITE_*.
CENTRAL_AUTH_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:5175

# Production only: non-secret host path to the connection file provisioned by platform-deploy.
# Expected: /opt/docker/pior-labs/secrets/app-cookbook/database-url
PLATFORM_DATABASE_URL_FILE=
