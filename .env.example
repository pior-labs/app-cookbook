# Application identity
APP_SLUG=myapp
COMPOSE_PROJECT_NAME=myapp

# Local development
API_PORT=3000
WEB_PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myapp_dev
# Optional when the API itself runs in Docker during local development.
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/myapp_dev

# Central Pior Labs authentication.
# Follow service-auth documentation for the current issuer and callback contract.
CENTRAL_AUTH_ISSUER=http://localhost:5173/api/auth
CENTRAL_AUTH_CLIENT_ID=myapp
CENTRAL_AUTH_CLIENT_SECRET=replace-me
PUBLIC_BASE_URL=http://localhost:5173

# Production only: non-secret host path to the connection file provisioned by platform-deploy.
# Example: /opt/docker/pior-labs/secrets/app-myapp/database-url
PLATFORM_DATABASE_URL_FILE=
