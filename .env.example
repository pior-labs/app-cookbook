# Application identity
APP_SLUG=cookbook
COMPOSE_PROJECT_NAME=cookbook

# Local development
API_PORT=3002
WEB_PORT=5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cookbook_dev
# Optional when the API itself runs in Docker during local development.
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/cookbook_dev

# Central Pior Labs authentication.
# Follow service-auth documentation for the current issuer and callback contract.
CENTRAL_AUTH_ISSUER=https://auth.szarans.ca/api/auth
CENTRAL_AUTH_DISCOVERY_URL=https://auth.szarans.ca/api/auth/.well-known/openid-configuration
CENTRAL_AUTH_CLIENT_ID=cookbook
# Set only in a local .env or the production secret store. Never expose through VITE_*.
CENTRAL_AUTH_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:5173

# Cookbook's own encrypted, HTTP-only application session.
BETTER_AUTH_SECRET=replace-with-a-separate-cookbook-session-secret
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Recipe image storage (technical design section 8).
# Defaults to .data/images in the repository when unset. In production this must be a
# persistent directory mounted into the API container and backed up with the database.
IMAGE_STORAGE_DIR=
# Optional overrides. Defaults: 10 MiB, 800px card, 1600px detail.
IMAGE_MAX_BYTES=
IMAGE_CARD_MAX_WIDTH=
IMAGE_DETAIL_MAX_WIDTH=

# Production only: non-secret host path to the image directory provisioned by platform-deploy.
# Expected: /opt/docker/pior-labs/data/app-cookbook/images
PLATFORM_IMAGE_STORAGE_DIR=

# Production only: non-secret host path to the connection file provisioned by platform-deploy.
# Expected: /opt/docker/pior-labs/secrets/app-cookbook/database-url
PLATFORM_DATABASE_URL_FILE=

# MCP server (ADR 0006). Read-only recipe tools over stdio, for a household
# member's own assistant. Not needed to run the application.
#
# The household member this server acts as. Favorites and the caller's own
# ratings answer for this person and no one else, so each member configures
# their own client with their own address rather than sharing one entry. It
# must match a user who has signed in through central SSO at least once.
COOKBOOK_MCP_USER_EMAIL=
# debug | info | warn | error. Logs are written to stderr; stdout carries the
# MCP protocol.
MCP_LOG_LEVEL=
