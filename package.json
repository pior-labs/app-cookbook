{
  "name": "app-cookbook",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @cookbook/api --filter @cookbook/web dev",
    "dev:api": "pnpm --filter @cookbook/api dev",
    "dev:web": "pnpm --filter @cookbook/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @cookbook/api db:generate",
    "db:migrate": "pnpm --filter @cookbook/api db:migrate"
  }
}
